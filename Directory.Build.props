<Project>

  <!--
    Settings every project in the repo shares. They were copy-pasted identically into all six
    .csproj files (in two different orders), which meant a seventh project could silently miss
    one, and adding an eighth setting meant remembering six edits.

    Deliberately not set here yet: TreatWarningsAsErrors, EnableNETAnalyzers and
    EnforceCodeStyleInBuild. Turning those on is the point of having this file, but each one
    surfaces a batch of existing warnings that wants triaging on its own, not smuggled into a
    build-configuration change.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    The release version, shared by the API and the worker: semver, bumped by hand in the pull
    request that makes a release (fix = patch, feature = minor, breaking = major). /healthz
    reports it in X-App-Version.

    The SDK would otherwise append "+<commit>" to the informational version whenever a build
    can see .git, so local builds and image builds would disagree. The commit already has its
    own header, X-Source-Sha.
  -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
