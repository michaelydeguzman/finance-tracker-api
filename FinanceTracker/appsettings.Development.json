{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "finance-tracker-api",
    "Audience": "finance-tracker-ui",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "AppBaseUrl": "http://localhost:3000",
    "EmailVerificationHours": 24,
    "MagicLinkMinutes": 15,
    "PasswordResetMinutes": 60,
    "MinimumPasswordLength": 12
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "no-reply@finance-tracker.local",
    "FromName": "Finance Tracker",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "UseStartTls": false
    }
  }
}
